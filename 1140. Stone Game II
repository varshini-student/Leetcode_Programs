class Solution {

    int[][] dp;
    int[] suffix;

    public int stoneGameII(int[] piles) {

        int n = piles.length;

        dp = new int[n][n + 1];
        suffix = new int[n + 1];

        // Suffix sum
        for (int i = n - 1; i >= 0; i--) {
            suffix[i] = suffix[i + 1] + piles[i];
        }

        return solve(0, 1, n);
    }

    int solve(int i, int M, int n) {

        // All piles are taken
        if (i >= n) {
            return 0;
        }

        // Already calculated
        if (dp[i][M] != 0) {
            return dp[i][M];
        }

        int maxStones = 0;

        // Try taking X piles
        for (int X = 1; X <= 2 * M && i + X <= n; X++) {

            // Stones opponent can get
            int opponent = solve(
                i + X,
                Math.max(M, X),
                n
            );

            // Current player's stones
            int current = suffix[i] - opponent;

            maxStones = Math.max(maxStones, current);
        }

        dp[i][M] = maxStones;

        return maxStones;
    }
}
