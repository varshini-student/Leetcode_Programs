
import java.util.*;

class Solution {
    public int[] assignTasks(int[] servers, int[] tasks) {

        PriorityQueue<int[]> available = new PriorityQueue<>(
            (a, b) -> {
                if (a[0] != b[0])
                    return Integer.compare(a[0], b[0]);
                return Integer.compare(a[1], b[1]);
            }
        );

        PriorityQueue<long[]> busy = new PriorityQueue<>(
            (a, b) -> {
                if (a[0] != b[0])
                    return Long.compare(a[0], b[0]);
                if (a[1] != b[1])
                    return Long.compare(a[1], b[1]);
                return Long.compare(a[2], b[2]);
            }
        );

        int n = servers.length;
        int m = tasks.length;

        int[] ans = new int[m];

        for (int i = 0; i < n; i++) {
            available.offer(new int[]{servers[i], i});
        }

        long time = 0;
        int task = 0;

        while (task < m) {

            // Release all completed servers.
            while (!busy.isEmpty() &&
                   busy.peek()[0] <= time) {

                long[] s = busy.poll();

                available.offer(new int[]{
                    (int) s[1],
                    (int) s[2]
                });
            }

            // Assign a task if it has arrived
            // and a server is available.
            if (task <= time && !available.isEmpty()) {

                int[] s = available.poll();

                int weight = s[0];
                int index = s[1];

                ans[task] = index;

                busy.offer(new long[]{
                    time + tasks[task],
                    weight,
                    index
                });

                task++;

            } else if (available.isEmpty()) {

                // Wait until the earliest server is free.
                time = busy.peek()[0];

            } else {

                // Wait for the next task to arrive.
                time = task;
            }
        }

        return ans;
    }
}
