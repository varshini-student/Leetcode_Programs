class Solution {
    public int[] validSequence(String word1, String word2) {

        int n = word1.length();
        int m = word2.length();

        int[] ans = new int[m];

        // last[j] = position in word1 where word2[j]
        // can be matched while matching word2[j...m-1]
        int[] last = new int[m];

        for (int i = 0; i < m; i++) {
            last[i] = -1;
        }

        int i = n - 1;
        int j = m - 1;

        // Build last[] from right to left
        while (i >= 0 && j >= 0) {

            if (word1.charAt(i) == word2.charAt(j)) {
                last[j] = i;
                j--;
            }

            i--;
        }

        // We are allowed to use one mismatch
        boolean canChange = true;

        j = 0;

        // Greedily choose the smallest possible indices
        for (i = 0; i < n && j < m; i++) {

            // Case 1: Exact match
            if (word1.charAt(i) == word2.charAt(j)) {

                ans[j] = i;
                j++;
            }

            // Case 2: Use the one allowed mismatch
            else if (canChange &&
                     (j == m - 1 || i < last[j + 1])) {

                ans[j] = i;
                j++;
                canChange = false;
            }
        }

        // Couldn't form word2
        if (j != m) {
            return new int[0];
        }

        return ans;
    }
}
