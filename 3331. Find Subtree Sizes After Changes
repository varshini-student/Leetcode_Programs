
class Solution {
    public int[] findSubtreeSizes(int[] parent, String s) {
        int n = parent.length;

        // Build adjacency list
        List<Integer>[] children = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            children[i] = new ArrayList<>();
        }

        for (int i = 1; i < n; i++) {
            children[parent[i]].add(i);
        }

        int[] newParent = parent.clone();
        int[] last = new int[26];
        Arrays.fill(last, -1);

        // Find the closest matching ancestor
        dfs(0, children, s, last, newParent);

        // Build the modified tree
        List<Integer>[] newChildren = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            newChildren[i] = new ArrayList<>();
        }

        for (int i = 1; i < n; i++) {
            newChildren[newParent[i]].add(i);
        }

        // Calculate subtree sizes
        int[] answer = new int[n];
        calculate(0, newChildren, answer);

        return answer;
    }

    private void dfs(int node, List<Integer>[] children,
                     String s, int[] last, int[] newParent) {

        int c = s.charAt(node) - 'a';

        int previous = last[c];

        if (node != 0 && previous != -1) {
            newParent[node] = previous;
        }

        last[c] = node;

        for (int child : children[node]) {
            dfs(child, children, s, last, newParent);
        }

        // Backtrack to restore ancestor state
        last[c] = previous;
    }

    private int calculate(int node, List<Integer>[] children,
                          int[] answer) {

        int size = 1;

        for (int child : children[node]) {
            size += calculate(child, children, answer);
        }

        answer[node] = size;
        return size;
    }
}
