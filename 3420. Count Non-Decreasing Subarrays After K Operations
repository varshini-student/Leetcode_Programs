
import java.util.*;

class Solution {
    public long countNonDecreasingSubarrays(int[] nums, int k) {
        int n = nums.length;

        // Each pair stores {value, count}
        Deque<int[]> dq = new ArrayDeque<>();

        long cost = 0;
        long ans = 0;

        int right = n - 1;

        for (int left = n - 1; left >= 0; left--) {

            int num = nums[left];
            int count = 1;

            // Merge smaller values into the current value.
            while (!dq.isEmpty() && dq.peekLast()[0] < num) {

                int[] last = dq.pollLast();

                int value = last[0];
                int frequency = last[1];

                count += frequency;

                cost += (long) (num - value) * frequency;
            }

            dq.offerLast(new int[]{num, count});

            // Shrink the window until its cost is <= k.
            while (cost > k) {

                int[] first = dq.pollFirst();

                int value = first[0];
                int frequency = first[1];

                cost -= (long) (value - nums[right]);
                right--;

                if (frequency > 1) {
                    dq.offerFirst(
                        new int[]{value, frequency - 1}
                    );
                }
            }

            // All subarrays [left ... right] are valid.
            ans += right - left + 1;
        }

        return ans;
    }
}
