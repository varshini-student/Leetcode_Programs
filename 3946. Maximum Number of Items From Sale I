
class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;

        // Calculate free items obtained by activating each item type.
        int[] free = new int[n];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i != j && items[j][0] % items[i][0] == 0) {
                    free[i]++;
                }
            }
        }

        // dp[b] = maximum value after activating some item types
        // with total activation cost exactly b.
        int[] dp = new int[budget + 1];

        for (int i = 0; i < n; i++) {
            int cost = items[i][1];
            int gain = 1 + free[i];

            for (int b = budget; b >= cost; b--) {
                dp[b] = Math.max(dp[b],
                                 dp[b - cost] + gain);
            }
        }

        // Find the best activated subset and spend remaining
        // budget on additional copies of the cheapest item.
        int minPrice = Integer.MAX_VALUE;
        for (int[] item : items) {
            minPrice = Math.min(minPrice, item[1]);
        }

        int ans = 0;

        for (int b = 0; b <= budget; b++) {
            ans = Math.max(ans,
                dp[b] + (budget - b) / minPrice);
        }

        return ans;
    }
}
